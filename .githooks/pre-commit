#!/usr/bin/env bash
# Fast pre-commit gate: secret paths, then harness lint.
#
# Opt in per checkout (hooks are not shared by git itself):
#
#     git config core.hooksPath .githooks
#
# The secret check always runs. It refuses .env, keys, notify-local.toml,
# settings.local.json, and console/.cache. Tickets, logs, and investigations
# are allowed — a fork commits those.
#
# Harness lint runs only when the commit touches harness config. It
# deliberately does NOT run pytest. A pre-commit hook that takes ten seconds
# gets bypassed with --no-verify within a week, and then it is not a gate at
# all. The full suite belongs in CI, which is not competing for your attention.

set -e

PY=""
for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done

if [ -z "$PY" ]; then
  # No interpreter is not a reason to block a commit — say so and get out of
  # the way. CI still runs the same checks.
  echo "pre-commit: no python on PATH, skipping secret check and harness lint" >&2
  exit 0
fi

if ! "$PY" console/kanban.py workspace check --staged; then
  echo ""
  echo "pre-commit: refusing to commit a secret path. Tickets, logs, and"
  echo "investigations are allowed. Commit with --no-verify if you know why"
  echo "this one is wrong."
  exit 1
fi

if ! git diff --cached --name-only | grep -qE '^(\.claude/(skills|agents)/|CLAUDE\.md)'; then
  exit 0
fi

if ! "$PY" console/kanban.py harness lint; then
  echo ""
  echo "pre-commit: harness lint failed. Fix the errors above, or commit"
  echo "with --no-verify if you know why this one is wrong."
  exit 1
fi
