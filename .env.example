# Delivery Console secrets. Copy this file to `.env` in the same directory
# and fill in the values. `.env` is gitignored; this example is safe to commit.
#
# Loaded by console/server/dotenv.py for the CLI, the web UI, and MCP.
# A variable already exported in the shell always wins over a value here.
# Full-line comments start with #. An unquoted value ends at " #".
# Blank assignments are fine: an empty value does not override a shell export
# that already has a value, but the name still counts as present.

# OpenRouter key (https://openrouter.ai/keys). The openrouter backend in
# console/config/agents.toml stays unavailable until this has a value.
OPENROUTER_API_KEY=

# OpenAI key (https://platform.openai.com/api-keys). Used by the openai
# backend and by Codex when you are not signed in with `codex`. Codex writes
# the key into a per-chat CODEX_HOME, not into ~/.codex.
OPENAI_API_KEY=

# Only if a provider's api_key_env is LMSTUDIO_API_KEY. The shipped
# lm-studio row uses auth = "none" and ignores this. LM Studio often
# accepts any non-empty string when its local server has API auth on.
LMSTUDIO_API_KEY=

# Outbound Telegram (approvals, turn end, job errors).
# Token from @BotFather (/newbot). Chat id from:
#   python console/kanban.py notify chat-id
# Group ids are negative — keep the minus sign.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Inbound Telegram: who may answer approvals and drive agents.
# Numeric USER ids, not chat ids. See: python console/kanban.py notify who
# Fail-closed: with neither of the next two set, the bot answers nobody.
# TELEGRAM_USER_ID is enough for one person. If TELEGRAM_ALLOWED_USERS is
# set (comma-separated), TELEGRAM_USER_ID is not consulted.
TELEGRAM_USER_ID=
TELEGRAM_ALLOWED_USERS=

# Development only. true, 1, yes, or on lets any Telegram user through
# and is announced at every start. Leave blank.
TELEGRAM_ALLOW_ALL_USERS=
