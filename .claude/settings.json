{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git commit:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.key)",
      "Read(./**/credentials.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-context.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/console-refresh.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/console-refresh.sh"
          }
        ]
      }
    ]
  }
}
